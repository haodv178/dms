datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  WAREHOUSE
  DRIVER
}

enum OrderStatus {
  NEW
  PICKING
  PACKED
  DELIVERING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  COD
  CREDIT_CARD
  MOMO
  BANK_TRANSFER
  ZALOPAY
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DriverStatus {
  AVAILABLE
  ON_DELIVERY
  OFFLINE
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(WAREHOUSE)
  isActive      Boolean        @default(true)
  driverProfile DriverProfile?
  trips         Trip[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DriverProfile {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      Int
  store        Store        @relation(fields: [storeId], references: [id])
  phone        String
  vehicleType  String       @default("Xe máy")
  licensePlate String
  status       DriverStatus @default(AVAILABLE)
  isActive     Boolean      @default(true)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([storeId])
}

model Store {
  id          Int             @id @default(autoincrement())
  code        String?         @unique
  name        String
  address     String
  latitude    Float           // Điểm xuất phát (Depot) cho thuật toán VRP
  longitude   Float
  phone       String          @default("")
  isDefault   Boolean         @default(false)
  isActive    Boolean         @default(true)
  notes       String?
  orders      Order[]
  trips       Trip[]
  depotStocks DepotStock[]
  drivers     DriverProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
}

model Order {
  id               Int         @id @default(autoincrement())
  orderCode        String      @unique
  storeId          Int
  store            Store       @relation(fields: [storeId], references: [id])
  customerName     String
  customerPhone    String
  customerAddress  String
  latitude         Float       // Tọa độ GPS khách hàng
  longitude        Float
  totalAmount      Decimal       @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(UNPAID)
  paidAt           DateTime?
  paymentReference String?
  status           OrderStatus   @default(NEW)
  items            OrderItem[]
  tripId           Int?
  trip             Trip?       @relation(fields: [tripId], references: [id])
  deliverySequence Int?        // Thứ tự dừng xe do OR-Tools tối ưu (1, 2, 3...)
  deliveryDate     String      @default("2026-01-01") // YYYY-MM-DD (Asia/Ho_Chi_Minh)
  hourDelivery     Int         @default(9)            // 9..19 (11 khung giờ giao/ngày)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([deliveryDate, hourDelivery])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  sku         String?
  productName String
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
}

model Trip {
  id            Int      @id @default(autoincrement())
  tripCode      String   @unique
  storeId       Int
  store         Store    @relation(fields: [storeId], references: [id])
  driverId      Int?
  driver        User?    @relation(fields: [driverId], references: [id])
  orders        Order[]
  status        String   @default("ASSIGNED") // ASSIGNED | IN_TRANSIT | COMPLETED
  totalDistance Float?   // Mét hoặc km
  deliveryDate  String   @default("2026-01-01") // YYYY-MM-DD (Asia/Ho_Chi_Minh)
  hourDelivery  Int      @default(9)            // 9..19 (tất cả đơn trong chuyến cùng khung giờ)
  createdAt     DateTime @default(now())

  @@index([deliveryDate, hourDelivery])
  @@index([driverId, deliveryDate, hourDelivery, status])
}

model Product {
  id          Int          @id @default(autoincrement())
  sku         String       @unique
  name        String
  category    String       @default("Thực phẩm")
  unit        String       @default("Cái")
  price       Decimal      @db.Decimal(10, 2)
  isActive    Boolean      @default(true)
  depotStocks DepotStock[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DepotStock {
  id        Int      @id @default(autoincrement())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
}
