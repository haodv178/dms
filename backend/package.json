{
  "name": "dms-backend",
  "version": "1.0.0",
  "description": "DMS Backend (Express + TypeScript + Prisma)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts",
    "seed:drivers": "ts-node prisma/seed-drivers.ts",
    "seed:orders": "ts-node prisma/seed-orders.ts",
    "delete:orders": "ts-node prisma/delete-orders.ts",
    "seed:products1000": "ts-node prisma/seed-1000-products.ts",
    "commands": "ts-node scripts/list-commands.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
